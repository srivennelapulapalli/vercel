}


/* =========================================================
   STORAGE
========================================================= */

function savePosts(){

    localStorage.setItem(
        "posts",
        JSON.stringify(posts)
    );

}


/* =========================================================
   AUTH
========================================================= */

function showSignup(){

    document.getElementById("loginForm")
        .style.display="none";

    document.getElementById("signupForm")
        .style.display="block";

}


function showLogin(){

    document.getElementById("signupForm")
        .style.display="none";

    document.getElementById("loginForm")
        .style.display="block";

}


function signup(){

    let name =
        document.getElementById("signupName")
        .value.trim();

    let username =
        document.getElementById("signupUsername")
        .value.trim();

    let password =
        document.getElementById("signupPassword")
        .value;


    if(!name || !username || !password){

        alert(
            "Please fill all fields."
        );

        return;

    }


    let exists =
        users.find(
            u => u.username === username
        );


    if(exists){

        alert(
            "Username already exists."
        );

        return;

    }


    let user = {

        name:name,
        username:username,
        password:password

    };


    users.push(user);


    localStorage.setItem(
        "users",
        JSON.stringify(users)
    );


    currentUser = user;


    localStorage.setItem(
        "currentUser",
        JSON.stringify(currentUser)
    );


    startApp();

}


function login(){

    let username =
        document.getElementById("loginUsername")
        .value.trim();

    let password =
        document.getElementById("loginPassword")
        .value;


    if(!username || !password){

        alert(
            "Enter username and password."
        );

        return;

    }


    let user =
        users.find(
            u =>
            (u.username === username ||
             u.name === username)
            &&
            u.password === password
        );


    /*
       Demo account if no registered
       account exists.
    */

    if(!user){

        user = {

            name:username,
            username:username,
            password:password

        };

        users.push(user);

        localStorage.setItem(
            "users",
            JSON.stringify(users)
        );

    }


    currentUser = user;


    localStorage.setItem(
        "currentUser",
        JSON.stringify(currentUser)
    );


    startApp();

}


function startApp(){

    document.getElementById("authScreen")
        .style.display="none";

    document.getElementById("app")
        .style.display="block";


    updateProfile();

    renderPosts();

    renderPeople();

}


function logout(){

    localStorage.removeItem(
        "currentUser"
    );

    location.reload();

}


/* =========================================================
   PROFILE
========================================================= */

function updateProfile(){

    if(!currentUser)
        return;


    let first =
        currentUser.name
        .charAt(0)
        .toUpperCase();


    document.getElementById(
        "createAvatar"
    ).innerText=first;


    document.getElementById(
        "profileAvatar"
    ).innerText=first;


    document.getElementById(
        "profileName"
    ).innerText=currentUser.name;


    document.getElementById(
        "profileUsername"
    ).innerText=
        "@"+currentUser.username;


    document.getElementById(
        "postCount"
    ).innerText =
        posts.filter(
            p =>
            p.username === currentUser.username
        ).length;

}


function editProfile(){

    let name =
        prompt(
            "Enter new name:",
            currentUser.name
        );


    if(name){

        currentUser.name=name;

        localStorage.setItem(
            "currentUser",
            JSON.stringify(currentUser)
        );

        updateProfile();

        alert(
            "Profile updated!"
        );

    }

}


/* =========================================================
   NAVIGATION
========================================================= */

function showPage(page){

    document
        .querySelectorAll(".page")
        .forEach(
            p => p.classList.remove("active")
        );


    document
        .getElementById(page)
        .classList.add("active");


    document
        .querySelectorAll(".menu")
        .forEach(
            m => m.classList.remove("active")
        );


    window.scrollTo(0,0);

}


/* =========================================================
   RENDER POSTS
========================================================= */

function renderPosts(){

    let container =
        document.getElementById(
            "postsContainer"
        );


    container.innerHTML="";


    posts.slice().reverse().forEach(
        post => {

            let div =
                document.createElement("div");


            div.className="post searchablePost";


            let first =
                post.user
                .charAt(0)
                .toUpperCase();


            let commentsHTML =
                post.comments
                .map(
                    c =>
                    `<p>
                        <b>${c.user}</b> ${c.text}
                    </p>`
                )
                .join("");


            div.innerHTML=`

                <div class="postHeader">

                    <div class="postUser">

                        <div class="userAvatar">
                            ${first}
                        </div>

                        <div>

                            <b>
                                ${post.user}
                            </b>

                            <br>

                            <small>
                                @${post.username}
                                · ${post.time}
                            </small>

                        </div>

                    </div>

                    <div
                        class="postMenu"
                        onclick="postOptions(${post.id})">

                        ⋮

                    </div>

                </div>


                <div class="postBody">

                    ${escapeHTML(post.text)}

                </div>


                ${
                    post.image
                    ?
                    `<img
                        class="postImage"
                        src="${post.image}">`
                    :
                    ""
                }


                <div class="postStats">

                    ❤️ ${post.likes}
                    &nbsp;&nbsp;

                    💬 ${post.comments.length}
                    comments

                </div>


                <div class="postActions">

                    <button
                        class="${post.liked ? 'liked':''}"
                        onclick="toggleLike(${post.id})">

                        ❤️ Like

                    </button>


                    <button
                        onclick="focusComment(${post.id})">

                        💬 Comment

                    </button>


                    <button
                        onclick="sharePost(${post.id})">

                        ↗ Share

                    </button>


                    <button
                        class="${post.saved ? 'saved':''}"
                        onclick="toggleSave(${post.id})">

                        🔖 Save

                    </button>

                </div>


                <div class="comments">

                    ${commentsHTML}


                    <div class="commentInput">

                        <input
                            id="comment-${post.id}"
                            placeholder="Write a comment...">

                        <button
                            onclick="addComment(${post.id})">

                            Post

                        </button>

                    </div>

                </div>

            `;


            container.appendChild(div);

        }
    );


    updateProfile();

}


/* =========================================================
   HTML ESCAPE
========================================================= */

function escapeHTML(text){

    let div =
        document.createElement("div");

    div.textContent=text;

    return div.innerHTML;

}


/* =========================================================
   LIKE
========================================================= */

function toggleLike(id){

    let post =
        posts.find(
            p => p.id===id
        );


    if(!post)
        return;


    if(post.liked){

        post.likes--;

        post.liked=false;

    }

    else{

        post.likes++;

        post.liked=true;

    }


    savePosts();

    renderPosts();

}


/* =========================================================
   COMMENT
========================================================= */

function addComment(id){

    let input =
        document.getElementById(
            "comment-"+id
        );


    let text =
        input.value.trim();


    if(!text)
        return;


    let post =
        posts.find(
            p => p.id===id
        );


    post.comments.push({

        user:
            currentUser.name,

        text:text

    });


    savePosts();

    renderPosts();

}


function focusComment(id){

    let input =
        document.getElementById(
            "comment-"+id
        );


    if(input){

        input.focus();

    }

}


/* =========================================================
   SHARE
========================================================= */

function sharePost(id){

    let post =
        posts.find(
            p => p.id===id
        );


    navigator.clipboard
        ?.writeText(
            post.text
        );


    alert(
        "Post link copied! You can share it."
    );

}


/* =========================================================
   SAVE
========================================================= */

function toggleSave(id){

    let post =
        posts.find(
            p => p.id===id
        );


    post.saved =
        !post.saved;


    if(post.saved){

        if(!saved.includes(id))
            saved.push(id);

    }

    else{

        saved =
            saved.filter(
                x => x!==id
            );

    }


    localStorage.setItem(
        "saved",
        JSON.stringify(saved)
    );


    savePosts();

    renderPosts();

    renderSaved();

}


function renderSaved(){

    let box =
        document.getElementById(
            "savedPosts"
        );


    let savedPosts =
        posts.filter(
            p => saved.includes(p.id)
        );


    if(savedPosts.length===0){

        box.innerHTML=`

            <div class="card">

                You have no saved posts.

            </div>

        `;

        return;

    }


    box.innerHTML =
        savedPosts
        .map(
            p =>
            `<div class="card">

                <b>${p.user}</b>

                <br><br>

                ${escapeHTML(p.text)}

            </div>`
        )
        .join("");

}


/* =========================================================
   CREATE POST
========================================================= */

function openPostModal(){

    document.getElementById(
        "postModal"
    ).style.display="flex";

}


function closePostModal(){

    document.getElementById(
        "postModal"
    ).style.display="none";

}


function publishPost(){

    let text =
        document.getElementById(
            "newPostText"
        ).value.trim();


    let file =
        document.getElementById(
            "imageInput"
        ).files[0];


    if(!text && !file){

        alert(
            "Write something or select an image."
        );

        return;

    }


    if(file){

        let reader =
            new FileReader();


        reader.onload=function(e){

            createNewPost(
                text,
                e.target.result
            );

        };


        reader.readAsDataURL(file);

    }

    else{

        createNewPost(
            text,
            null
        );

    }

}


function createNewPost(text,image){

    let newPost={

        id:
            Date.now(),

        user:
            currentUser.name,

        username:
            currentUser.username,

        text:
            text,

        image:
            image,

        likes:0,

        comments:[],

        liked:false,

        saved:false,

        time:"Just now"

    };


    posts.push(newPost);

    savePosts();

    renderPosts();

    closePostModal();


    document.getElementById(
        "newPostText"
    ).value="";


    document.getElementById(
        "imageInput"
    ).value="";


    alert(
        "Your post has been published!"
    );

}


/* =========================================================
   POST OPTIONS
========================================================= */

function postOptions(id){

    let post =
        posts.find(
            p => p.id===id
        );


    let action =
        prompt(
            "Type: delete or cancel"
        );


    if(
        action &&
        action.toLowerCase()==="delete"
    ){

        if(
            post.username ===
            currentUser.username
        ){

            posts =
                posts.filter(
                    p => p.id!==id
                );

            savePosts();

            renderPosts();

            alert(
                "Post deleted."
            );

        }

        else{

            alert(
                "You can only delete your own posts."
            );

        }

    }

}


