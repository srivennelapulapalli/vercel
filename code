<script>

/* =========================================================
   DATA
========================================================= */

let currentUser =
    JSON.parse(
        localStorage.getItem("currentUser")
    );


let users =
    JSON.parse(
        localStorage.getItem("users")
    ) || [];


let posts =
    JSON.parse(
        localStorage.getItem("posts")
    ) || [];


let saved =
    JSON.parse(
        localStorage.getItem("saved")
    ) || [];


let chats =
    JSON.parse(
        localStorage.getItem("chats")
    ) || {};


/* =========================================================
   DEFAULT POSTS
========================================================= */

if(posts.length === 0){

    posts = [

        {
            id:1,
            user:"Rahul Kumar",
            username:"rahul",
            text:
            "Just completed my new web development project! Learning new technologies every day. #Technology #Coding",
            likes:24,
            comments:[],
            liked:false,
            saved:false,
            time:"2 hours ago"
        },

        {
            id:2,
            user:"Ananya Sharma",
            username:"ananya",
            text:
            "Having a wonderful day with my friends! ❤️ #Travel #Friends",
            likes:56,
            comments:[],
            liked:false,
            saved:false,
            time:"5 hours ago"
        },

        {
            id:3,
            user:"Priya Reddy",
            username:"priya",
            text:
            "Never stop learning. Every small step takes you closer to your goals. 📚 #Education",
            likes:91,
            comments:[],
            liked:false,
            saved:false,
            time:"Yesterday"
        }

    ];

