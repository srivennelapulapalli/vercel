/* =========================================================
   SEARCH
========================================================= */

function globalSearch(){

    let value =
        document.getElementById(
            "globalSearch"
        ).value.toLowerCase();


    if(!value){

        renderPosts();

        return;

    }


    showPage("home");


    let all =
        document.querySelectorAll(
            ".searchablePost"
        );


    all.forEach(
        post => {

            if(
                post.innerText
                .toLowerCase()
                .includes(value)
            ){

                post.style.display="block";

            }

            else{

                post.style.display="none";

            }

        }
    );

}


function searchTopic(topic){

    document.getElementById(
        "globalSearch"
    ).value=topic;


    showPage("home");

    globalSearch();

}


function filterExplore(){

    let value =
        document.getElementById(
            "exploreSearch"
        ).value.toLowerCase();


    document
        .querySelectorAll(".trend")
        .forEach(
            item => {

                item.style.display =
                    item.innerText
                    .toLowerCase()
                    .includes(value)
                    ?
                    "block"
                    :
                    "none";

            }
        );

}


/* =========================================================
   CHAT
========================================================= */

let activeChat="";


function openChat(name){

    activeChat=name;


    document.getElementById(
        "chatWindow"
    ).style.display="block";


    document.getElementById(
        "chatTitle"
    ).innerText=
        "Chat with "+name;


    renderChat();

}


function renderChat(){

    let messages =
        chats[activeChat] || [];


    document.getElementById(
        "chatMessages"
    ).innerHTML =
        messages
        .map(
            m =>
            `<div
                class="message
                ${m.mine?'myMessage':''}">

                ${escapeHTML(m.text)}

            </div>`
        )
        .join("");


    let box =
        document.getElementById(
            "chatMessages"
        );

    box.scrollTop =
        box.scrollHeight;

}


function sendChat(){

    let input =
        document.getElementById(
            "chatInput"
        );


    let text =
        input.value.trim();


    if(!text || !activeChat)
        return;


    if(!chats[activeChat])
        chats[activeChat]=[];


    chats[activeChat].push({

        text:text,

        mine:true

    });


    localStorage.setItem(
        "chats",
        JSON.stringify(chats)
    );


    input.value="";

    renderChat();

}


function chatEnter(event){

    if(event.key==="Enter"){

        sendChat();

    }

}


/* =========================================================
   DARK MODE
========================================================= */

function toggleDarkMode(){

    document.body
        .classList
        .toggle("dark");


    let enabled =
        document.body
        .classList
        .contains("dark");


    document.getElementById(
        "darkToggle"
    ).classList.toggle(
        "on",
        enabled
    );


    localStorage.setItem(
        "darkMode",
        enabled
    );

}


/* =========================================================
   INITIALIZE
========================================================= */

if(
    localStorage.getItem(
        "darkMode"
    )==="true"
){

    document.body
        .classList
        .add("dark");

    document.getElementById(
        "darkToggle"
    )?.classList.add("on");

}


if(currentUser){

    startApp();

}


renderSaved();

</script>

