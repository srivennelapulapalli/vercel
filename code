<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ConnectSphere</title>

<style>

/* =========================================================
   RESET
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

:root{
    --primary:#6c5ce7;
    --secondary:#8e7dff;
    --bg:#f4f5fb;
    --card:#ffffff;
    --text:#222;
    --muted:#777;
    --border:#e5e5e5;
    --danger:#e74c3c;
    --success:#20bf6b;
}

body{
    background:var(--bg);
    color:var(--text);
    transition:.3s;
}

button{
    border:none;
    cursor:pointer;
}

input,
textarea{
    outline:none;
}


/* =========================================================
   LOGIN
========================================================= */

#authScreen{

    min-height:100vh;

    display:flex;
    align-items:center;
    justify-content:center;

    background:
        linear-gradient(
            135deg,
            #5f55e8,
            #9b59b6
        );
}

.authBox{

    width:400px;
    max-width:92%;

    background:white;

    padding:40px;

    border-radius:25px;

    box-shadow:
        0 20px 60px rgba(0,0,0,.25);

    text-align:center;
}

.brand{

    font-size:36px;
    font-weight:bold;

    background:
        linear-gradient(
            90deg,
            #6c5ce7,
            #e84393
        );

    -webkit-background-clip:text;
    color:transparent;

    margin-bottom:8px;
}

.authSubtitle{
    color:#777;
    margin-bottom:25px;
}

.authInput{

    width:100%;

    padding:14px;

    border:1px solid #ddd;

    border-radius:12px;

    margin:8px 0;
}

.primaryBtn{

    width:100%;

    padding:14px;

    background:var(--primary);

    color:white;

    border-radius:12px;

    font-size:16px;

    margin-top:10px;
}

.primaryBtn:hover{
    background:#5749d6;
}

.authSwitch{

    margin-top:20px;
    color:var(--primary);
    cursor:pointer;
}


/* =========================================================
   APPLICATION
========================================================= */

#app{
    display:none;
}


/* =========================================================
   TOP BAR
========================================================= */

.topbar{

    height:70px;

    background:var(--card);

    border-bottom:1px solid var(--border);

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 4%;

    position:sticky;

    top:0;

    z-index:1000;
}

.logo{

    font-size:25px;
    font-weight:bold;

    color:var(--primary);
}

.searchBox{

    width:350px;

    padding:11px 18px;

    border-radius:25px;

    border:1px solid var(--border);

    background:var(--bg);
}

.topIcons{

    display:flex;

    gap:20px;

    font-size:21px;
}

.topIcons span{
    cursor:pointer;
}


/* =========================================================
   LAYOUT
========================================================= */

.layout{

    max-width:1450px;

    margin:25px auto;

    display:grid;

    grid-template-columns:
        230px
        minmax(400px,1fr)
        290px;

    gap:25px;

    padding:0 20px;
}


/* =========================================================
   LEFT SIDEBAR
========================================================= */

.sidebar{

    background:var(--card);

    border-radius:18px;

    padding:15px;

    height:max-content;

    position:sticky;

    top:90px;
}

.menu{

    padding:14px;

    border-radius:12px;

    margin:4px 0;

    cursor:pointer;

    display:flex;

    gap:12px;

    align-items:center;
}

.menu:hover,
.menu.active{

    background:#eeeaff;

    color:var(--primary);

    font-weight:bold;
}


/* =========================================================
   PAGES
========================================================= */

.page{
    display:none;
}

.page.active{
    display:block;
}


/* =========================================================
   STORIES
========================================================= */

.stories{

    background:var(--card);

    padding:15px;

    border-radius:18px;

    display:flex;

    gap:14px;

    overflow:auto;

    margin-bottom:20px;
}

.story{

    min-width:70px;

    text-align:center;

    cursor:pointer;
}

.storyAvatar{

    width:65px;
    height:65px;

    border-radius:50%;

    padding:3px;

    background:
        linear-gradient(
            45deg,
            #f9ce34,
            #ee2a7b,
            #6228d7
        );
}

.storyAvatar div{

    width:100%;
    height:100%;

    border-radius:50%;

    display:flex;
    align-items:center;
    justify-content:center;

    background:var(--primary);

    color:white;

    font-weight:bold;

    border:3px solid white;
}

.story small{
    color:var(--muted);
}


/* =========================================================
   CARD
========================================================= */

.card{

    background:var(--card);

    padding:20px;

    border-radius:18px;

    margin-bottom:20px;

    box-shadow:
        0 4px 15px rgba(0,0,0,.04);
}


/* =========================================================
   CREATE POST
========================================================= */

.createTop{

    display:flex;

    align-items:center;

    gap:12px;
}

.userAvatar{

    width:45px;
    height:45px;

    border-radius:50%;

    background:
        linear-gradient(
            135deg,
            #6c5ce7,
            #e84393
        );

    color:white;

    display:flex;

    align-items:center;

    justify-content:center;

    font-weight:bold;
}

.postInput{

    flex:1;

    padding:13px;

    background:var(--bg);

    border:none;

    border-radius:25px;

    cursor:pointer;
}

.createActions{

    display:flex;

    gap:10px;

    margin-top:15px;
}

.createActions button{

    flex:1;

    padding:10px;

    border-radius:10px;

    background:var(--bg);
}


/* =========================================================
   POST
========================================================= */

.post{

    background:var(--card);

    border-radius:18px;

    margin-bottom:20px;

    overflow:hidden;

    box-shadow:
        0 4px 15px rgba(0,0,0,.04);
}

.postHeader{

    padding:17px;

    display:flex;

    align-items:center;

    justify-content:space-between;
}

.postUser{

    display:flex;

    align-items:center;

    gap:10px;
}

.postUser small{
    color:var(--muted);
}

.postMenu{
    font-size:22px;
    cursor:pointer;
}

.postBody{

    padding:0 17px 15px;

    line-height:1.6;
}

.postImage{

    width:100%;

    max-height:500px;

    object-fit:cover;

    display:block;
}

.postStats{

    padding:10px 17px;

    color:var(--muted);

    border-bottom:1px solid var(--border);
}

.postActions{

    display:flex;

    padding:8px 10px;
}

.postActions button{

    flex:1;

    padding:12px;

    background:none;

    color:var(--muted);

    border-radius:10px;
}

.postActions button:hover{
    background:var(--bg);
}

.liked{
    color:#e74c3c !important;
}

.saved{
    color:var(--primary) !important;
}


/* =========================================================
   COMMENTS
========================================================= */

.comments{

    padding:12px 17px;

    border-top:1px solid var(--border);

}

.commentInput{

    display:flex;

    gap:8px;

    margin-top:10px;
}

.commentInput input{

    flex:1;

    padding:10px;

    border-radius:20px;

    border:1px solid var(--border);
}

.commentInput button{

    background:var(--primary);

    color:white;

    padding:8px 15px;

    border-radius:20px;
}


/* =========================================================
   RIGHT SIDEBAR
========================================================= */

.rightCard{

    background:var(--card);

    border-radius:18px;

    padding:20px;

    margin-bottom:20px;
}

.person{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin:15px 0;
}

.personInfo{

    display:flex;

    align-items:center;

    gap:10px;
}

.followBtn{

    padding:7px 12px;

    border-radius:8px;

    background:var(--primary);

    color:white;
}


/* =========================================================
   EXPLORE
========================================================= */

.exploreSearch{

    width:100%;

    padding:14px;

    border-radius:12px;

    border:1px solid var(--border);

    margin-bottom:20px;
}

.trends{

    display:grid;

    grid-template-columns:
        repeat(2,1fr);

    gap:15px;
}

.trend{

    padding:25px;

    border-radius:15px;

    color:white;

    background:
        linear-gradient(
            135deg,
            #6c5ce7,
            #e84393
        );

    cursor:pointer;
}


/* =========================================================
   PROFILE
========================================================= */

.cover{

    height:190px;

    background:
        linear-gradient(
            135deg,
            #6c5ce7,
            #e84393
        );

    border-radius:
        18px 18px 0 0;
}

.profileCard{

    background:var(--card);

    text-align:center;

    padding:25px;

    border-radius:
        0 0 18px 18px;
}

.profileAvatar{

    width:100px;
    height:100px;

    margin:
        -75px auto 15px;

    border-radius:50%;

    background:var(--primary);

    border:5px solid var(--card);

    color:white;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:35px;

    font-weight:bold;
}

.profileStats{

    display:flex;

    justify-content:center;

    gap:60px;

    margin:25px 0;
}


/* =========================================================
   MESSAGES
========================================================= */

.chatList{

    background:var(--card);

    border-radius:18px;

    overflow:hidden;
}

.chatUser{

    padding:18px;

    border-bottom:1px solid var(--border);

    cursor:pointer;
}

.chatUser:hover{

    background:var(--bg);
}

.chatWindow{

    background:var(--card);

    border-radius:18px;

    margin-top:20px;

    padding:20px;
}

.chatMessages{

    height:300px;

    overflow:auto;

    padding:10px;
}

.message{

    padding:10px 15px;

    border-radius:15px;

    margin:8px 0;

    max-width:70%;

    background:var(--bg);
}

.myMessage{

    margin-left:auto;

    background:var(--primary);

    color:white;
}

.chatInput{

    display:flex;

    gap:10px;

    margin-top:15px;
}

.chatInput input{

    flex:1;

    padding:12px;

    border-radius:20px;

    border:1px solid var(--border);
}

.chatInput button{

    background:var(--primary);

    color:white;

    padding:10px 20px;

    border-radius:20px;
}


/* =========================================================
   NOTIFICATIONS
========================================================= */

.notification{

    background:var(--card);

    padding:18px;

    border-radius:15px;

    margin-bottom:10px;

    display:flex;

    gap:15px;
}


/* =========================================================
   SETTINGS
========================================================= */

.setting{

    background:var(--card);

    padding:20px;

    border-radius:15px;

    margin-bottom:12px;

    display:flex;

    justify-content:space-between;

    align-items:center;
}

.toggle{

    width:50px;
    height:25px;

    background:#bbb;

    border-radius:20px;

    position:relative;

    cursor:pointer;
}

.toggle::after{

    content:"";

    width:21px;
    height:21px;

    background:white;

    border-radius:50%;

    position:absolute;

    top:2px;
    left:2px;

    transition:.2s;
}

.toggle.on{
    background:var(--primary);
}

.toggle.on::after{
    left:27px;
}


/* =========================================================
   MODAL
========================================================= */

.modal{

    position:fixed;

    inset:0;

    background:
        rgba(0,0,0,.6);

    display:none;

    align-items:center;

    justify-content:center;

    z-index:2000;
}

.modalBox{

    width:500px;

    max-width:92%;

    background:var(--card);

    padding:25px;

    border-radius:20px;
}

.modalBox textarea{

    width:100%;

    min-height:150px;

    padding:15px;

    border:1px solid var(--border);

    border-radius:12px;

    resize:none;
}

.modalButtons{

    display:flex;

    gap:10px;

    margin-top:15px;
}

.modalButtons button{

    flex:1;

    padding:12px;

    border-radius:10px;
}


/* =========================================================
   DARK MODE
========================================================= */

.dark{

    --bg:#111218;
    --card:#1d1e27;
    --text:#f5f5f5;
    --border:#333440;
    --muted:#aaa;
}

.dark .menu:hover,
.dark .menu.active{

    background:#302b52;
}

.dark .postInput{

    background:#292a34;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1100px){

    .layout{

        grid-template-columns:
            200px 1fr;
    }

    .rightSidebar{
        display:none;
    }

}

@media(max-width:700px){

    .topbar{

        height:auto;

        padding:12px;

        flex-wrap:wrap;

        gap:10px;
    }

    .searchBox{

        order:3;

        width:100%;
    }

    .layout{

        display:block;

        padding:10px;
    }

    .sidebar{

        position:static;

        margin-bottom:15px;
    }

    .rightSidebar{

        display:none;
    }

    .trends{

        grid-template-columns:1fr;
    }

}

</style>

</head>


<body>


<!-- =========================================================
     AUTHENTICATION
========================================================= -->

<div id="authScreen">

    <div class="authBox">

        <div class="brand">
            ConnectSphere
        </div>

        <p class="authSubtitle">
            Connect • Share • Discover
        </p>


        <div id="loginForm">

            <input
                id="loginUsername"
                class="authInput"
                placeholder="Username or email">

            <input
                id="loginPassword"
                class="authInput"
                type="password"
                placeholder="Password">

            <button
                class="primaryBtn"
                onclick="login()">

                Login

            </button>

            <p
                class="authSwitch"
                onclick="showSignup()">

                Create a new account

            </p>

        </div>


        <div
            id="signupForm"
            style="display:none;">

            <input
                id="signupName"
                class="authInput"
                placeholder="Full name">

            <input
                id="signupUsername"
                class="authInput"
                placeholder="Username">

            <input
                id="signupPassword"
                class="authInput"
                type="password"
                placeholder="Password">

            <button
                class="primaryBtn"
                onclick="signup()">

                Create Account

            </button>

            <p
                class="authSwitch"
                onclick="showLogin()">

                Already have an account? Login

            </p>

        </div>

    </div>

</div>



<!-- =========================================================
     APP
========================================================= -->

<div id="app">


<!-- TOP BAR -->

